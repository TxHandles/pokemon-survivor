rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each player's save: only that player can read or write it.
    match /saves/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Leaderboard entries: any signed-in player can read; you can only write your own.
    match /lb/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid
                   && request.resource.data.j is string
                   && request.resource.data.j.size() < 100000;
    }
  }
}
